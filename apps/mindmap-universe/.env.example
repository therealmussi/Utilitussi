# AI provider configuration (copy to .env and edit as needed)
# or configure directly in the app: Settings -> AI provider
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# Example (OpenAI):
# VITE_AI_BASE_URL=https://api.openai.com/v1
# VITE_AI_API_KEY=sk-...   # never commit your real key: .env is git-ignored
# VITE_AI_MODEL=gpt-4o-mini

# Example (local Ollama gateway):
# VITE_AI_BASE_URL=http://localhost:11434/v1
# VITE_AI_MODEL=llama3.1
