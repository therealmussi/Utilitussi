# LIFE COST SIMULATOR — environment template
# Copy to `.env` and fill in only what you need. The app runs with zero config.

# Optional: mirror for the free, keyless exchange-rate endpoint
# (https://open.er-api.com/v6/latest/EUR). Use your own mirror if you self-host.
VITE_EXCHANGE_RATE_API_URL=

# Optional (future backend): Supabase project for cloud-synced accounts.
# Do NOT put secret (service) keys here — VITE_* variables are public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (never prefix with VITE_): licensed data provider keys, e.g.
NUMBEO_API_KEY=
